# Variables de entorno requeridas para el login de /administracion (ver
# lib/adminAuth.js). Copia este archivo a .env.local para desarrollo local
# (.env.local no se sube a git — ver .gitignore) y agrega las mismas 3
# variables en Vercel: Project Settings → Environment Variables.

# Usuario y contraseña del panel de administración.
ADMIN_USER=
ADMIN_PASSWORD=

# Secreto usado para firmar la cookie de sesión — cualquier texto largo y
# aleatorio sirve, por ejemplo generado con: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Almacenamiento del contenido del panel (para que los cambios los vean
# todos los visitantes). En Vercel: Project → Storage →
#  1. "Upstash for Redis" (Marketplace) → conectar al proyecto. Crea solas
#     KV_REST_API_URL y KV_REST_API_TOKEN.
#  2. "Blob" → crear y conectar al proyecto. Crea sola BLOB_READ_WRITE_TOKEN.
# Para probar en local: `vercel env pull .env.local` o copiarlas a mano.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
